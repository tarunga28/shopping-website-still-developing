# ─────────────────────────────────────────────────────────────
# Inkline — environment configuration
# Copy to `.env` and fill in values per environment.
# NEVER commit a real `.env`. Never expose secret values to the
# browser — only NEXT_PUBLIC_* variables are client-visible.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Authentication (Auth.js / next-auth v5) ──────────────────
# REQUIRED in every environment. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Trust the host header (needed on Vercel / reverse proxies)
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments — Razorpay (primary, India) ─────────────────────
# key_id is safe for the browser; key_secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ── Payments — Stripe (future, international) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── POD supplier (Printrove / Printful / QikInk …) ───────────
POD_PROVIDER=
POD_API_BASE_URL=
POD_API_KEY=
POD_API_SECRET=
POD_WEBHOOK_SECRET=
# Set true only when the supplier integration is production-live.
FEATURE_POD_LIVE=false

# ── Object storage (S3-compatible: Cloudflare R2 / AWS S3) ───
# Design artwork, print files and customer uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=

# ── Transactional email ──────────────────────────────────────
EMAIL_FROM="Inkline <hello@inkline.in>"
RESEND_API_KEY=
# …or SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Analytics & monitoring ───────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=

# ── Platform ops ─────────────────────────────────────────────
# Protects future cron/maintenance routes: openssl rand -base64 32
CRON_SECRET=
# Salt for hashing IP addresses stored at rest (privacy).
IP_HASH_SALT=
