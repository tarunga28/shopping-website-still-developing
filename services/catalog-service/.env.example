# Catalog-intelligence service configuration.
#
# Copy to .env for local development. Every variable is prefixed so this file
# can sit next to the Next.js app's .env without colliding.

# ── service ──────────────────────────────────────────────────────────────
CATALOG_SERVICE_ENVIRONMENT=development
CATALOG_SERVICE_LOG_LEVEL=INFO
# Comma-separated origins allowed to call this service directly. Leave empty in
# production: the Next.js server calls this service server-to-server, so no
# browser origin should need access.
CATALOG_SERVICE_CORS_ORIGINS=

# ── database ─────────────────────────────────────────────────────────────
# The SAME PostgreSQL instance the Next.js application uses. Use the psycopg
# driver prefix, not plain "postgresql://".
CATALOG_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/inkline
CATALOG_SERVICE_DATABASE_POOL_SIZE=5
CATALOG_SERVICE_DATABASE_MAX_OVERFLOW=10
CATALOG_SERVICE_DATABASE_POOL_TIMEOUT_SECONDS=30

# ── native ranking engine ────────────────────────────────────────────────
# Absolute path to libcppsearch.so. Leave empty to search the usual places
# (native/cpp-search/build/ inside the repository, then the loader path).
CATALOG_SERVICE_CPPSEARCH_LIBRARY=
# Rebuild the in-memory index at most this often, in seconds.
CATALOG_SERVICE_INDEX_REFRESH_SECONDS=300
CATALOG_SERVICE_INDEX_MAX_DOCUMENTS=500000

# ── tuning ───────────────────────────────────────────────────────────────
CATALOG_SERVICE_SEARCH_DEFAULT_LIMIT=20
CATALOG_SERVICE_SEARCH_MAX_LIMIT=100
CATALOG_SERVICE_MAX_EDIT_DISTANCE=1
CATALOG_SERVICE_MIN_FUZZY_LENGTH=4
CATALOG_SERVICE_RECOMMENDATIONS_DEFAULT_LIMIT=8
CATALOG_SERVICE_RECOMMENDATIONS_MAX_LIMIT=24
